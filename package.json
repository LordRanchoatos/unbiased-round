{
  "name": "unbiased-round",
  "version": "1.0.0",
  "description": "Banker's rounding (round half to even) \u2014 tiny, dependency-free, TypeScript-first.",
  "keywords": [
    "bankers-rounding",
    "banker",
    "round",
    "rounding",
    "round-half-to-even",
    "half-even",
    "gaussian-rounding",
    "convergent-rounding",
    "unbiased",
    "currency",
    "money",
    "decimal",
    "precision",
    "math",
    "typescript"
  ],
  "license": "MIT",
  "author": "LordRanchoatos <atolagbedt@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LordRanchoatos/unbiased-round.git"
  },
  "homepage": "https://github.com/LordRanchoatos/unbiased-round#readme",
  "bugs": {
    "url": "https://github.com/LordRanchoatos/unbiased-round/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=16"
  },
  "scripts": {
    "build": "node init && tsup && tsc -p tsconfig.build.json && node scripts/dual-types.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "dotenv": "^8.2.0",
    "node-fetch": "^3.3.2",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public",
    "provenance": false
  }
}
